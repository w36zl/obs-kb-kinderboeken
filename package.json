{
  "name": "obs-kb-kinderboeken",
  "version": "1.3.0",
  "description": "Obsidian plugin that pulls Nederlandse Kinderboeken metadata en covers from the Koninklijke Bibliotheek APIs.",
  "main": "main.js",
  "scripts": {
    "clean": "rm -rf dist main.js main.d.ts obs-kb-kinderboeken.zip",
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "package": "npm run build && zip -r obs-kb-kinderboeken.zip manifest.json main.js main.d.ts styles.css README.md"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "kinderboeken",
    "koninklijke bibliotheek"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "@types/node": "^20.11.30",
    "bundle-require": "^5.1.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "joycon": "^3.1.1",
    "obsidian": "^1.5.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.1"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.6",
    "yaml": "^2.4.2"
  }
}
